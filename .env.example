# Prefer apps/api/.env (loaded automatically). Root .env also works.

# Local live LLM discovery (never commit keys):
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Alternate live provider:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Offline / local experimentation (not assignment LLM proof):
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=hermes3:latest

API_PORT=8787
OPERATOR_PORT=8787

# SauceDemo public demo user — hardcoded in the profile if unset.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Draft capabilities are not replayable unless explicitly opted in.
# Unattended agent invocation never honors this flag (approved only).
# ALLOW_DRAFT_REPLAY=1

# Hosted Vercel — only these two additional secrets are required.
# Vercel automatically selects Browserbase. Local automatically selects Chromium.
# The assessment uses one fixed Browserbase project ID in server-side config.
# Never put real values here.
BROWSERBASE_API_KEY=
BLOB_READ_WRITE_TOKEN=
